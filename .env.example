# ========================================================
# Adaptive Workflow AI Voice Bot - Configuration
# ========================================================

# BOT EXECUTION MODE: BASELINE | OPTIMIZED
BOT_MODE=OPTIMIZED

# PROVIDERS: MOCK | OPENAI | GROQ | DEEPGRAM | ELEVENLABS | EDGE_TTS
# MOCK mode runs offline; EDGE_TTS uses Microsoft Neural Voices (Neerja/Swara for India)
LLM_PROVIDER=MOCK
STT_PROVIDER=MOCK
TTS_PROVIDER=EDGE_TTS

# API KEYS (Leave blank when using MOCK or EDGE_TTS providers)
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# VOICE PERSONALITY & REGIONAL SETTINGS (India & Uttar Pradesh)
# Available voices: en-IN-NeerjaNeural (Female), en-IN-PrabhatNeural (Male), hi-IN-SwaraNeural (Hindi Female), hi-IN-MadhurNeural (Hindi Male)
VOICE_NAME=en-IN-NeerjaNeural
VOICE_REGION=India / Uttar Pradesh
VOICE_SPEAKING_SPEED=1.0
VOICE_TONE=neutral
VOICE_STYLE=concise

# LATENCY TARGETS (in milliseconds)
TARGET_TTFT_MS=300
TARGET_TTFA_MS=600

# LOGGING
LOG_LEVEL=INFO
